# ==============================================================================
# Atlassian Jira Federated Data Connector - Environment Configuration
# ==============================================================================
# Copy this file to .env and populate with your credentials.
#
# Note:
# Terraform automatically detects and parses .env in the root directory
# to configure the Jira data connector credentials and instance metadata.
# ==============================================================================

# 1. Atlassian OAuth 2.0 (3LO) Client ID
# Created in Atlassian Developer Console (https://developer.atlassian.com/console)
JIRA_CLIENT=your_atlassian_oauth_client_id_here

# 2. Atlassian OAuth 2.0 (3LO) Client Secret
# Created in Atlassian Developer Console
JIRA_SECRET=your_atlassian_oauth_client_secret_here

# 3. Jira Cloud Site Domain
# Your Atlassian Cloud site domain (e.g., example.atlassian.net or example.jira.com)
JIRA_SITE=your-domain.atlassian.net

# 4. Atlassian Cloud Instance / Tenant ID
# The unique GUID identifier for your Atlassian Cloud site
# Can be retrieved via: https://<your-domain>.atlassian.net/_edge/tenant_info
JIRA_CLOUD_ID=00000000-0000-0000-0000-000000000000
